{
  "schemaVersion": 1,
  "id": "cobblemon_skin",
  "version": "${version}",
  "name": "CobblemonSkin",
  "description": "Allows players to apply custom skins/textures to their Cobblemon Pokémon via forcedAspects + variation JSON.",
  "authors": ["YourName"],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      { "adapter": "kotlin", "value": "com.example.cobblemon_skin.CobblemonSkinMod" }
    ],
    "client": [
      { "adapter": "kotlin", "value": "com.example.cobblemon_skin.client.SkinClientMod" }
    ]
  },
  "mixins": ["cobblemon_skin.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "minecraft": "~${minecraft_version}",
    "cobblemon": "*"
  }
}
